{
  "rules": {
    //"_說明_全域": "預設拒絕所有讀寫，必須在子節點明確開放才能存取",
    ".read": false,
    ".write": false,

    //"_說明_staff": "員工白名單：自己讀自己的 UID 節點；只有 admin 能寫；必填 role 與 email",
    "staff": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('staff').child(auth.uid).child('role').val() === 'admin'",
        ".validate": "newData.hasChildren(['role','email'])"
      }
    },

    //"_說明_menu": "菜單資料：任何人可讀（含未登入顧客掃 QR），僅登入帳號可寫",
    "menu": {
      "$projectId": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    //"_說明_posBackup": "POS 端本地備份：登入後可讀寫自己店的快照",
    "posBackup": {
      "$storeId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    //"_說明_customers": "顧客主檔：登入後可讀寫",
    "customers": {
      "$customerKey": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    //"_說明_customerOrders": "顧客訂單：依 createdAt / customerLookupKey 建索引以加速查詢",
    "customerOrders": {
      ".indexOn": ["createdAt", "customerLookupKey"],
      "$orderId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    //"_說明_onlineOrders": "線上點餐單：依店別分類，依 createdAt / status / customerPhone 建索引",
    "onlineOrders": {
      "$storeCode": {
        ".read": "auth != null",
        ".indexOn": ["createdAt", "status", "customerPhone"],
        "$orderId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },

    //"_說明_dashboards": "多店即時看板資料：登入後可讀寫（POS 端寫入心跳/今日營業，看板端讀取顯示）",
    "dashboards": {
      ".read": "auth != null",
      "$storeId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    //"_說明_sessionHistory": "歷史班次紀錄：POS 端結班時寫入，多店看板讀取產生歷史報表；保留 90 天由 POS 端自動清理",
    "sessionHistory": {
      ".read": "auth != null",
      "$storeId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
